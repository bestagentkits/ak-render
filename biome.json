{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.js",
      "tests/**/*.ts",
      "scripts/**/*.mjs",
      "benchmarks/**/*.mjs",
      "*.ts",
      "*.json",
      "!.git",
      "!dist",
      "!node_modules",
      "!docs/artifacts",
      "!src/render/embedded-fonts.generated.ts",
      "!src/icons/icon-data.generated.ts",
      "!src/blocks/three/three-runtime.generated.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  }
}
