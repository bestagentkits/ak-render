{
  "name": "@agentkit/render",
  "version": "0.1.0",
  "private": false,
  "description": "Declarative Page Spec compiler: deterministic, offline, interactive standalone HTML from JSON/YAML.",
  "keywords": [
    "agentkit",
    "renderer",
    "page-spec",
    "declarative",
    "html",
    "compiler",
    "deterministic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bestagentkits/ak-render.git"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@9.15.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ak-render": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-cli-executable.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:package": "node scripts/package-smoke.mjs",
    "test:clean-install": "node scripts/clean-install-verify.mjs",
    "gallery:generate": "node scripts/generate-gallery.mjs",
    "gallery:check": "node scripts/generate-gallery.mjs --check",
    "bench:baseline": "node benchmarks/legacy-context-cost.mjs",
    "bench:render": "node benchmarks/render-benchmark.mjs",
    "bench:browser": "playwright test tests/browser/benchmark.spec.ts",
    "bench": "pnpm build && pnpm bench:render && pnpm bench:browser",
    "schema:generate": "node scripts/generate-json-schema.mjs",
    "schema:check": "node scripts/generate-json-schema.mjs --check",
    "snapshots:generate": "node scripts/generate-theme-snapshots.mjs",
    "snapshots:check": "node scripts/generate-theme-snapshots.mjs --check",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.15.0",
    "ajv": "^8.17.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  }
}
