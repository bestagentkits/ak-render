/**
 * Opt-in Cloudflare deployment for the AK Render cloud renderer.
 *
 * Nothing here is required to use @bestagentkits/render: local compilation never
 * contacts this worker, and the compiler has no knowledge of it. Deploy only
 * when a hosted render, share, screenshot, or PDF route is actually wanted.
 *
 * Bindings:
 *   RENDER_SHARES  R2 bucket, private. Shares and short-lived MCP render artifacts.
 *                  Lifecycle rules: r2-lifecycle.json (applied by a deploy step).
 *   RATE_LIMIT_*   Workers Rate Limiting bindings, one per route class. Limits
 *                  mirror RATE_LIMITS in src/config.ts (a unit test keeps them equal).
 *   BROWSER        Browser Run binding. Screenshot and PDF only.
 *
 * Routes: the Worker answers /mcp, /v1/* and the OAuth protected-resource
 * metadata under /.well-known/oauth-protected-resource on render.agentkit.best. That
 * hostname is a Custom Domain of the static site (site/wrangler.jsonc); Worker
 * routes on a Custom Domain's hostname run before it, so these paths reach
 * this Worker and every other path still reaches the site. workers.dev stays
 * enabled as an undocumented fallback.
 *
 * Vars are configuration, never secrets. The bearer a caller presents is
 * validated against ENTITLEMENTS_URL, or, when it is an OAuth access token for
 * OAUTH_RESOURCE, against OAUTH_ISSUER's public JWKS. It is never stored here.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ak-render-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    // No content logging: a page body must never reach the log stream.
    "enabled": false
  },
  "vars": {
    // Origin of the canonical AgentKit entitlements endpoint; the Worker calls
    // GET {ENTITLEMENTS_URL}/api/agentkit/entitlements with the caller's bearer.
    "ENTITLEMENTS_URL": "https://agentkit.best",
    "OAUTH_ISSUER": "https://agentkit.best",
    "OAUTH_RESOURCE": "https://render.agentkit.best/mcp",
    "SHARE_RETENTION_DAYS": "30"
  },
  "r2_buckets": [
    {
      "binding": "RENDER_SHARES",
      "bucket_name": "ak-render-shares"
    }
  ],
  // Rate limits per 60 s. namespace_id is an account-unique integer this
  // config chooses; keep the ids stable, because changing one resets its
  // counters. Per subject: render, share, export, validate. Per client IP:
  // anonymous MCP discovery calls, and bearer checks the cache cannot answer.
  "ratelimits": [
    { "name": "RATE_LIMIT_RENDER", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "RATE_LIMIT_SHARE", "namespace_id": "4102", "simple": { "limit": 20, "period": 60 } },
    { "name": "RATE_LIMIT_EXPORT", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_VALIDATE", "namespace_id": "4104", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_ANON_IP", "namespace_id": "4105", "simple": { "limit": 120, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH_IP", "namespace_id": "4106", "simple": { "limit": 30, "period": 60 } }
  ],
  // Browser Run Quick Actions (screenshot, pdf) need compatibility_date
  // 2026-03-24 or later.
  "browser": {
    "binding": "BROWSER"
  },
  "routes": [
    { "pattern": "render.agentkit.best/mcp", "zone_name": "agentkit.best" },
    { "pattern": "render.agentkit.best/v1/*", "zone_name": "agentkit.best" },
    { "pattern": "render.agentkit.best/.well-known/oauth-protected-resource*", "zone_name": "agentkit.best" }
  ],
  "triggers": {
    // Hourly sweep so an expired share or render artifact stops resolving even
    // before its read path is exercised.
    "crons": ["0 * * * *"]
  }
}
