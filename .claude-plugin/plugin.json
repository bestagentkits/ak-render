  "license": "MIT",
  "keywords": ["html", "report", "page-spec", "yaml", "offline", "mcp"],
  "mcpServers": {
    "ak-render": {
      "command": "npx",
      "args": ["-y", "@bestagentkits/render@0.3.0", "mcp"]
    }
  }
}
